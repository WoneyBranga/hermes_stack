# =============================================================================
# Hermes Multi-Instance Stack — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Then bring the stack up:
#
#   docker compose up -d
#
# =============================================================================

# -----------------------------------------------------------------------------
# LiteLLM (LLM provider for every hermes-agent instance)
# -----------------------------------------------------------------------------
# LiteLLM proxies are OpenAI-compatible. The URL below is what the
# hermes-agent containers will dial. Two common cases:
#
#   1. LiteLLM runs as a sibling service on the same Docker host:
#        LITELLM_BASE_URL=http://litellm:4000/v1
#      Make sure the litellm container joins the `hermes-net` network
#      (`docker network connect hermes-net litellm`) or attach it to the same
#      compose project.
#
#   2. LiteLLM runs on the host (outside Docker):
#        LITELLM_BASE_URL=http://host.docker.internal:4000/v1
#
#   3. LiteLLM is hosted somewhere else (cloud / k8s ingress):
#        LITELLM_BASE_URL=https://litellm.example.com/v1
#
LITELLM_BASE_URL=http://host.docker.internal:4000/v1

# Master key configured on the LiteLLM proxy (`LITELLM_MASTER_KEY`).
# Required if the proxy enforces auth; safe to leave as a placeholder
# when running an unauthenticated dev proxy.
LITELLM_API_KEY=sk-litellm-change-me

# Default model name the agents request from LiteLLM. Must match a model
# alias declared in the LiteLLM `config.yaml` on the proxy side.
HERMES_DEFAULT_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Host UID / GID — used so bind-mounted files stay readable on the host
# -----------------------------------------------------------------------------
# On macOS UIDs typically start at 501. Run:
#   echo "HOST_UID=$(id -u)"
#   echo "HOST_GID=$(id -g)"
# and paste the output in your `.env`.
HOST_UID=501
HOST_GID=20

# -----------------------------------------------------------------------------
# Per-instance WebUI passwords (REQUIRED — webuis refuse to start without one)
# -----------------------------------------------------------------------------
# Add one entry per running instance. When you scale with
# `./scripts/add-instance.sh N <password>`, the script appends the
# matching variable here for you.
HERMES_WEBUI_PASSWORD_1=change-me-instance-1
HERMES_WEBUI_PASSWORD_2=change-me-instance-2
