# Proxy settings injected into hermes-agent-* and hermes-webui-* containers.
# Referenced from docker-compose.yml via `env_file:`.
# Preencha com as URLs do seu proxy corporativo (com http:// ou https://).
# Deixe NO_PROXY com os hosts internos que NAO devem passar pelo proxy.

HTTP_PROXY=http://user:pass@proxy.empresa.local:8080
HTTPS_PROXY=http://user:pass@proxy.empresa.local:8080
NO_PROXY=localhost,127.0.0.1,hermes-net,hermes-agent-1,hermes-agent-2,hermes-webui-1,hermes-webui-2,litellm,.empresa.local

# Lowercase variants — algumas libs Python (requests, urllib3) so leem em minusculas.
http_proxy=http://user:pass@proxy.empresa.local:8080
https_proxy=http://user:pass@proxy.empresa.local:8080
no_proxy=localhost,127.0.0.1,hermes-net,hermes-agent-1,hermes-agent-2,hermes-webui-1,hermes-webui-2,litellm,.empresa.local
